ARG BASE_IMAGE
FROM $BASE_IMAGE

RUN if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache openssh-server; \
    elif command -v apt-get >/dev/null 2>&1; then \
        apt-get update && \
        apt-get install -y --no-install-recommends openssh-server && \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "Unsupported base image: no apk or apt-get found" >&2; \
        exit 1; \
    fi && \
    mkdir -p /run/sshd && \
    ssh-keygen -A

RUN if command -v apk >/dev/null 2>&1; then \
        SHELL_BIN=/bin/sh; [ -x /bin/bash ] && SHELL_BIN=/bin/bash; \
        addgroup -g 2000 ctf-player && \
        adduser -D -u 2000 -G ctf-player -s "$SHELL_BIN" ctf-player; \
    else \
        SHELL_BIN=/bin/sh; [ -x /bin/bash ] && SHELL_BIN=/bin/bash; \
        groupadd -g 2000 ctf-player && \
        useradd -m -u 2000 -g ctf-player -s "$SHELL_BIN" ctf-player; \
    fi

RUN CHALLENGE_HOME="$(pwd)" && \
    sed -i "s#^\(ctf-player:[^:]*:[^:]*:[^:]*:[^:]*:\)[^:]*#\1${CHALLENGE_HOME}#" /etc/passwd
